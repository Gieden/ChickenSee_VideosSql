# Vercel Blob Storage Token (Automatically provided when attaching Vercel Blob in project)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# Local Agent Sync Authentication Secret (Must match SYNC_SECRET in agent/.env)
SYNC_SECRET="super-secret-sync-token-change-this"

# 1-User Dashboard Access Password
DASHBOARD_PASSWORD="change-this-to-a-strong-password"

# JWT Secret for Session Cookie signature
JWT_SECRET="generate-a-secure-random-32-byte-hex-string"
