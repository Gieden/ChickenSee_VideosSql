# Optiplex Local Agent Configuration
VERCEL_SYNC_URL="https://your-vercel-domain.vercel.app/api/sync"
SYNC_SECRET="super-secret-sync-token-change-this"
WATCH_DIR="./data"
POLL_INTERVAL_MS=500
STABILITY_THRESHOLD_MS=2500
MAX_RETRIES=3

# Set to 0 to skip cloud uploads (local-only mode)
ENABLE_CLOUD_SYNC=1
CHICKENSEE_LOCAL_STORAGE="C:\\ChickenSee_Local_Storage"
